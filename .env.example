GROQ_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000

# Signs the dashboard's login session cookie — any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Shared across every tenant's WhatsApp connection — set once here, and every business enters this
# same value as the "Verify Token" when registering the webhook in their own Meta App (see README).
# Per-business WhatsApp credentials (access token, phone number ID) are entered in that business's
# own Settings page in the dashboard, not here — this app is multi-tenant.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Browser push notifications, so a rep gets pinged even with the dashboard tab closed. Generate
# with `npx web-push generate-vapid-keys` — one keypair for the whole deployment, not per business.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email notifications via Resend (https://resend.com) — optional. Without RESEND_API_KEY, email
# alerts are skipped (logged, not thrown) and push notifications alone still work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used to build the "open this conversation" link in notification emails. Defaults to
# http://localhost:$PORT if unset — set this to your real deployed URL in production.
PUBLIC_URL=
