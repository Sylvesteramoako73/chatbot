GROQ_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000

# Signs the dashboard's login session cookie — any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Shared across every tenant's WhatsApp connection — set once here, and every business enters this
# same value as the "Verify Token" when registering the webhook in their own Meta App (see README).
# Per-business WhatsApp credentials (access token, phone number ID) are entered in that business's
# own Settings page in the dashboard, not here — this app is multi-tenant.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
