{
  "name": "website-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "RAG chatbot that learns a company's website and answers questions about it via the Claude API.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "ingest:crawl": "tsx src/ingest.ts crawl",
    "ingest:doc": "tsx src/ingest.ts doc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
